# =============================================================================
# DCC Portal environment variables — copy to .env.local and fill in.
# NEVER commit real values. Placeholders only.
# =============================================================================

# Public (sent to the browser): Supabase project URL and publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server only: secret (service-role) key. Used ONLY for creating/inviting auth
# accounts and resetting passwords from the admin screens. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Absolute URL of the deployed app (used in password-reset emails and on
# marksheet verification codes/QR links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: sign-in attempts allowed per IP per minute (default 20). Raise if many users share one NAT.
# AUTH_RATE_LIMIT_PER_MINUTE=20
# Optional: sign-in attempts allowed per account per minute (default 5).
# AUTH_RATE_LIMIT_PER_ACCOUNT=5

# -----------------------------------------------------------------------------
# Demo mode ("Bypass Login"). DEVELOPMENT / DEMO DEPLOYMENTS ONLY.
# When true: signed-out visitors are signed in automatically as the demo
# account and land on the dashboard; the login page shows a
# "Bypass Login / Demo Mode" button; and "admin / password123" works as a mock
# login. Anyone who can reach the site gets this account's role, so NEVER
# enable it on a deployment with real student data.
# -----------------------------------------------------------------------------
# DEMO_MODE=true
# Optional: which account demo mode signs in as (defaults: seeded Super Admin).
# DEMO_LOGIN_EMAIL=superadmin@dcc.example
# DEMO_LOGIN_PASSWORD=DccDemo@2026
